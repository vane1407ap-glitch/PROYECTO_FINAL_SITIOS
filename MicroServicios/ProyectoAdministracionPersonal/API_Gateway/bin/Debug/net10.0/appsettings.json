{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "Routes": [
    {
      "DownstreamPathTemplate": "/api/Login",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5037
        }
      ],
      "UpstreamPathTemplate": "/gateway/login",
      "UpstreamHttpMethod": [
        "POST"
      ]
    },

    {
      "DownstreamPathTemplate": "/api/Login/validar",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5037
        }
      ],
      "UpstreamPathTemplate": "/gateway/login/validar",
      "UpstreamHttpMethod": [
        "GET"
      ]
    },

    {
      "DownstreamPathTemplate": "/api/Empleados",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5149
        }
      ],
      "UpstreamPathTemplate": "/api/Empleados",
      "UpstreamHttpMethod": [
        "POST"
      ]
    },

    {
      "DownstreamPathTemplate": "/api/Puestos",
      "DownstreamScheme": "http",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5184
        }
      ],
      "UpstreamPathTemplate": "/gateway/puestos",
      "UpstreamHttpMethod": [
        "GET"
      ]
    }
  ],

  "GlobalConfiguration": {
    "BaseUrl": "http://localhost:5220"
  },

  "AllowedHosts": "*"
}